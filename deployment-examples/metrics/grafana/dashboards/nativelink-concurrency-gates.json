          "expr": "histogram_quantile(0.99, sum by (le) (\n  rate(nativelink_connection_manager_permit_wait_duration_milliseconds_bucket{service_namespace=~\"$instance\", connection_manager_endpoint=~\"$endpoint\"}[$__rate_interval])\n))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "title": "p99 Permit Wait",
      "type": "stat"
