{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "# NativeLink Concurrency Gates\nA store that holds every permit stops serving with no error and no latency signal. The wedge signature is **permits available = 0** with **requests waiting > 0** and the wait histogram climbing. `permits_total = 0` means the gate is unlimited, so the saturation panels drop that series.",
        "mode": "markdown"
      },
      "pluginVersion": "12.2.1",
      "title": "",
      "type": "text"
    },
    {
      "description": "Managers with no free permit and at least one request queued. Any value above zero means a store has stopped starting new RPCs.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(\n  (nativelink_connection_manager_permits_available{service_namespace=~\"$instance\", connection_manager_endpoint=~\"$endpoint\"} == 0)\n  and\n  (nativelink_connection_manager_waiting_requests{service_namespace=~\"$instance\", connection_manager_endpoint=~\"$endpoint\"} > 0)\n) or vector(0)",
          "legendFormat": "Wedged",
          "refId": "A"
        }
      ],
      "title": "Wedged Connection Managers",
      "type": "stat"
    },
    {
      "description": "Highest fraction of max_concurrent_requests permits held across all selected managers.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.99
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(\n  1 - (\n    nativelink_connection_manager_permits_available{service_namespace=~\"$instance\", connection_manager_endpoint=~\"$endpoint\"}\n    /\n    (nativelink_connection_manager_permits_total{service_namespace=~\"$instance\", connection_manager_endpoint=~\"$endpoint\"} > 0)\n  )\n)",
          "legendFormat": "Saturation",
          "refId": "A"
        }
      ],
      "title": "Worst Gate Saturation",
      "type": "stat"
    },
    {
      "description": "Requests queued for a permit or for an established channel, summed over the selected managers.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
