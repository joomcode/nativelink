          "expr": "sum(nativelink_connection_manager_waiting_requests{service_namespace=~\"$instance\", connection_manager_endpoint=~\"$endpoint\"})",
          "legendFormat": "Waiting",
          "refId": "A"
        }
      ],
      "title": "Requests Waiting",
      "type": "stat"
    },
    {
      "description": "99th percentile time spent inside ConnectionManager::connection. Healthy is sub-millisecond. This wait has no deadline, so a value near the top histogram boundary (300s) means the gate is saturated, not slow.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
