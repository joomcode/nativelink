        "content": "# NativeLink Store Metrics\nMonitor cache hit/miss rates and read/write latency for all stores",
        "mode": "markdown"
      },
      "pluginVersion": "12.2.1",
      "title": "",
      "type": "text"
    },
    {
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
