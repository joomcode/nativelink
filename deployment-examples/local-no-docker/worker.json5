// Local worker. It runs actions on this machine, with no container.
// The CAS and the AC are remote, so this process reaches them through
// gRPC stores.
{
  stores: [
    {
      name: "GRPC_CAS_STORE",
      grpc: {
        instance_name: "",
        endpoints: [
          {
            address: "grpc://127.0.0.1:50051",
          },
        ],
        store_type: "cas",
        experimental_remote_cache_compression: true,
      },
    },
    {
      name: "GRPC_AC_STORE",
      grpc: {
        instance_name: "",
        endpoints: [
          {
            address: "grpc://127.0.0.1:50051",
          },
        ],
        store_type: "ac",
      },
    },
    {
      name: "WORKER_FAST_SLOW_STORE",
      fast_slow: {
        // "fast" must be a filesystem store. The worker hardlinks out of
        // it to build the sandbox of each action.
        fast: {
          filesystem: {
            content_path: "/tmp/nativelink-local/worker/content",
            temp_path: "/tmp/nativelink-local/worker/tmp",
            eviction_policy: {
              // 10gb.
              max_bytes: 10000000000,
            },
          },
        },
        slow: {
          ref_store: {
            name: "GRPC_CAS_STORE",
          },
        },
      },
    },
  ],
  workers: [
    {
      local: {
        worker_api_endpoint: {
          uri: "grpc://127.0.0.1:50061",
        },
        cas_fast_slow_store: "WORKER_FAST_SLOW_STORE",
        upload_action_result: {
          ac_store: "GRPC_AC_STORE",
        },
        work_directory: "/tmp/nativelink-local/worker/work",
        platform_properties: {
          cpu_count: {
            values: [
              "1",
            ],
          },
          OSFamily: {
            values: [
              "",
            ],
          },
          "container-image": {
            values: [
              "",
            ],
          },
        },

        // use_namespaces and use_mount_namespace default to false. They are
        // Linux-only, and this example must also run on macOS.
      },
    },
  ],
  servers: [
    {
      name: "worker_health",
      listener: {
        http: {
          socket_address: "0.0.0.0:50071",
        },
      },
      services: {
        health: {},
      },
    },
  ],
}
